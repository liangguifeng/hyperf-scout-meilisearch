{
  "name": "liangguifeng/hyperf-scout-meilisearch",
  "description": "Hyperf MeiliSearch Scout provides a driver based solution to searching your Eloquent models. Inspired By Laravel Scout.",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "php",
    "hyperf",
    "scout",
    "meilisearch"
  ],
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.9",
    "http-interop/http-factory-guzzle": "^1.0",
    "hyperf/scout": "^3.1",
    "meilisearch/meilisearch-php": "^1.15"
  },
  "suggest": {
    "swow/swow": "Required to create swow components."
  },
  "autoload": {
    "psr-4": {
      "Hyperf\\Scout\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HyperfTest\\": "tests"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "extra": {
    "hyperf": {
      "config": "Hyperf\\Scout\\MeilisearchConfigProvider"
    }
  }
}
